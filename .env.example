# Copy to .env (not in git) and set your values: every tools/*.sh script reads it. Written as
# ${VAR:-value} so a value given on the command line wins (e.g. PS3=<other IP> tools/ps3.sh log).

# IP of your PS3 running webMAN MOD (CFW or HEN): deploy, logs, screenshots, benchmarks.
PS3=${PS3:-192.168.1.20}

# Seconds tools/ps3.sh deploy stays silent after launching the app (no webMAN request while the
# XMB loads it: on HEN that can hang the console). 15 is enough on CFW; use 30 on HEN.
#LAUNCH_WAIT=${LAUNCH_WAIT:-15}

# Part of your FireRed ROM's file name in roms/, if it doesn't contain "FireRed"
# (tools/bench.sh, tools/jitcheck.sh), e.g. a translated title.
#FIRERED=${FIRERED:-FireRed}
