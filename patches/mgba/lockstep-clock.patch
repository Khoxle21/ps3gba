 		coordinator->attachedPlayers[0] = p0;
 
 		struct GBASIOLockstepPlayer* player = TableIteratorGetValue(&coordinator->players, &iter);
-		coordinator->cycle = mTimingCurrentTime(&player->driver->d.p->p->timing);
