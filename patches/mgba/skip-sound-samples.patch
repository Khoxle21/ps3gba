+// While samples are skipped (GBAudioSkipSamples), the sample events due by `timestamp` run here,
+// in order and at their own times but without output, before anything reads or changes the
+// state they touch (every PSG access runs GBAudioRun, which samples first, or is NR52 above).
+// A real event samples up to when it is processed, a replayed one up to its own time: the same,
+// since either way the window ends at that event and sampling stops at a window's end.
+static void _replaySamples(struct GBAudio* audio, int32_t timestamp) {
+	while (audio->skipSamples && (int32_t) (timestamp - audio->sampleEvent.when) >= 0) {
+		int32_t when = audio->sampleEvent.when;
+		audio->sampleEvent.when += audio->sampleInterval * audio->timingFactor;
+		_sampleTo(audio, when);
+	}
+}
+
+// For a core nobody listens to: stops producing samples without changing anything the game can
+// observe. Turning it back on resumes exactly where an always-sampling core would be. Call it
+// again now and then while skipping (e.g. every frame): it runs the skipped samples due by then,
+// so they never pile up (with its sound off a game never reaches the PSG code that replays them).
+void GBAudioSkipSamples(struct GBAudio* audio, bool skip) {
+	if (audio->style == GB_AUDIO_GBA) {
+		return;
+	}
+	if (skip == audio->skipSamples) {
+		_replaySamples(audio, mTimingCurrentTime(audio->timing));
+		return;
+	}
+	if (skip) {
+		mTimingDeschedule(audio->timing, &audio->sampleEvent); // its `when` stays the next sample's time
+	} else {
+		_replaySamples(audio, mTimingCurrentTime(audio->timing));
+		mTimingScheduleAbsolute(audio->timing, &audio->sampleEvent, audio->sampleEvent.when);
+	}
+	audio->skipSamples = skip;
+}
