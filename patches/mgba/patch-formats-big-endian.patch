+++ b/src/util/patch-ips.c
@@ -8,6 +8,8 @@
 #include <mgba-util/patch.h>
 #include <mgba-util/vfs.h>
 
+#define IPS_EOF 0x454F46 // "EOF" read as an offset
+
 static size_t _IPSOutputSize(struct Patch* patch, size_t inSize);
 static bool _IPSApplyPatch(struct Patch* patch, const void* restrict in, size_t inSize, void* restrict out, size_t outSize);
 
@@ -37,10 +39,40 @@ bool loadPatchIPS(struct Patch* patch) {
 	return true;
 }
 
+// Fields are big-endian: read them bytewise, so that big-endian hosts read them too.
+static bool _readBE(struct VFile* vf, int bytes, uint32_t* value) {
+	uint8_t buffer[3];
+	if (vf->read(vf, buffer, bytes) != bytes) {
+		return false;
+	}
+	*value = 0;
+	int i;
+	for (i = 0; i < bytes; ++i) {
+		*value = *value << 8 | buffer[i];
+	}
+	return true;
+}
+
+// The input grown to the end of the furthest record: IPS offsets stop at 16MiB, so larger ROMs
+// keep their size.
 size_t _IPSOutputSize(struct Patch* patch, size_t inSize) {
-	UNUSED(patch);
-	UNUSED(inSize);
-	return 16 * 1024 * 1024; // IPS patches can grow up to 16MiB, but not beyond
+	if (patch->vf->seek(patch->vf, 5, SEEK_SET) != 5) {
+		return 0;
+	}
+	size_t outSize = inSize;
+	uint32_t offset = 0;
+	uint32_t size;
+	while (_readBE(patch->vf, 3, &offset) && offset != IPS_EOF && _readBE(patch->vf, 2, &size)) {
+		if (size) {
+			patch->vf->seek(patch->vf, size, SEEK_CUR);
+		} else if (!_readBE(patch->vf, 2, &size) || patch->vf->seek(patch->vf, 1, SEEK_CUR) < 0) {
+			return 0;
+		}
+		if (offset + size > outSize) {
+			outSize = offset + size;
+		}
+	}
+	return offset == IPS_EOF ? outSize : 0;
 }
 
