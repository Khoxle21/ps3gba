--- a/src/core/timing.c
+++ b/src/core/timing.c
@@ -106,10 +106,10 @@ int32_t mTimingTick(struct mTiming* timing, int32_t cycles) {
 #ifdef ENABLE_DEBUGGERS
 	timing->globalCycles += cycles;
 #endif
-	uint32_t masterCycles = timing->masterCycles;
 	while (timing->root) {
 		struct mTimingEvent* next = timing->root;
-		int32_t nextWhen = next->when - masterCycles;
+		// ps3gba: re-read, the GBA's DMA event advances the clock itself (gba/dma.c)
+		int32_t nextWhen = next->when - timing->masterCycles;
 		if (nextWhen > 0) {
 			return nextWhen;
 		}
