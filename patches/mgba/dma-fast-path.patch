+// ps3gba: memory a DMA may touch without side effects on events or other DMAs (no IO, no
+// cartridge hardware, no BIOS open bus).
+static bool _dmaPlainRegion(uint32_t region, bool source) {
+	switch (region) {
+	case GBA_REGION_EWRAM:
+	case GBA_REGION_IWRAM:
+	case GBA_REGION_PALETTE_RAM:
+	case GBA_REGION_VRAM:
+	case GBA_REGION_OAM:
+		return true;
+	case GBA_REGION_ROM0:
+	case GBA_REGION_ROM0_EX:
+	case GBA_REGION_ROM1:
+	case GBA_REGION_ROM1_EX:
+	case GBA_REGION_ROM2:
+		return source;
+	default:
+		return false;
+	}
+}
+
+// ps3gba: runs the next units of the active DMA, its event being due now (the timing root), as
+// long as each starts before any other event: exactly what GBADMAService does one event at a
+// time, without rescheduling the event in between. Only for middle units (not the first, which
+// sets up the cycle counts, nor the last) of a DMA between plain memory with no other DMA
+// pending, so nothing a unit does can start a DMA or schedule an event. False if it can't.
+static bool _dmaRunUnits(struct GBA* gba) {
+	struct mTiming* timing = &gba->timing;
+	struct GBAMemory* memory = &gba->memory;
+	struct ARMCore* cpu = gba->cpu;
+	int number = memory->activeDMA;
+	struct GBADMA* info = &memory->dma[number];
+	if (number < 0 || info->count == info->nextCount || (info->nextCount & 0xFFFFF) < 2 ||
+	    !_dmaPlainRegion(info->nextSource >> BASE_OFFSET, true) || !_dmaPlainRegion(info->nextDest >> BASE_OFFSET, false)) {
+		return false;
+	}
+	int i;
+	for (i = 0; i < 4; ++i) {
+		if (i != number && GBADMARegisterIsEnable(memory->dma[i].reg) && memory->dma[i].nextCount) {
+			return false;
+		}
+	}
+	struct mTimingEvent* event = timing->root;
+	struct mTimingEvent* other = event->next;
+	timing->root = other; // taken off the queue as mTimingTick does; GBADMAUpdate puts it back
+	uint32_t width = 2 << GBADMARegisterGetWidth(info->reg);
+	enum mMemoryAccessSource oldAccess = cpu->memory.accessSource;
+	do {
+#ifdef ENABLE_DEBUGGERS
+		timing->globalCycles += info->when - timing->masterCycles;
+#endif
+		timing->masterCycles = info->when; // this unit's event time
+		uint32_t source = info->nextSource;
+		uint32_t dest = info->nextDest;
+		uint32_t sourceRegion = source >> BASE_OFFSET;
+		uint32_t destRegion = dest >> BASE_OFFSET;
+		gba->performingDMA = 1 | (number << 1);
+		cpu->memory.accessSource = mACCESS_DMA;
+		info->when += 2 + info->cycles;
+		if (width == 4) {
+			info->latch = cpu->memory.load32(cpu, source, 0);
+			cpu->memory.store32(cpu, dest, info->latch, 0);
+			gba->bus = info->latch;
+		} else {
+			info->latch = cpu->memory.load16(cpu, source, 0);
+			info->latch |= info->latch << 16;
+			cpu->memory.store16(cpu, dest, info->latch >> (8 * (dest & 2)), 0);
+			gba->bus = (info->latch & 0xFFFF) | (info->latch << 16);
+		}
+		info->nextSource += info->sourceOffset;
+		info->nextDest += info->destOffset;
+		if (UNLIKELY(sourceRegion != info->nextSource >> BASE_OFFSET) || UNLIKELY(destRegion != info->nextDest >> BASE_OFFSET)) {
+			// Crossed region boundary (as GBADMAService)
+			if (info->nextSource >= GBA_BASE_ROM0 && info->nextSource < GBA_BASE_SRAM) {
+				info->sourceOffset = width;
+			} else {
+				info->sourceOffset = DMA_OFFSET[GBADMARegisterGetSrcControl(info->reg)] * width;
+			}
+			if (width == 4) {
+				info->cycles = memory->waitstatesSeq32[info->nextSource >> BASE_OFFSET] + memory->waitstatesSeq32[info->nextDest >> BASE_OFFSET];
+			} else {
+				info->cycles = memory->waitstatesSeq16[info->nextSource >> BASE_OFFSET] + memory->waitstatesSeq16[info->nextDest >> BASE_OFFSET];
+			}
+		}
+		--info->nextCount;
+		gba->performingDMA = 0;
+		cpu->memory.accessSource = oldAccess;
+	} while ((info->nextCount & 0xFFFFF) > 1 && (!other || (int32_t) (other->when - info->when) > 0) &&
+	         _dmaPlainRegion(info->nextSource >> BASE_OFFSET, true) && _dmaPlainRegion(info->nextDest >> BASE_OFFSET, false) &&
+	         timing->root == other && !timing->reroot);
+	GBADMAUpdate(gba);
+	return true;
+}
+
+// ps3gba: a DMA moves one unit per event, and games move ~2000 units per frame. While the DMA's
+// event is the next one due, run it again right here, exactly as GBAProcessEvents and
+// mTimingTick would (CPU blocked, time advanced to the event, nothing else in between), without
+// going back through them for every unit.
+void _dmaEvent(struct mTiming* timing, void* context, uint32_t cyclesLate) {
+	struct GBA* gba = context;
+	_dmaEventOnce(timing, context, cyclesLate);
+	while (timing->root == &gba->memory.dmaEvent && !timing->reroot && gba->cpuBlocked && !gba->earlyExit &&
+	       !*timing->relativeCycles) {
+		if (_dmaRunUnits(gba)) {
+			continue;
+		}
+#ifdef ENABLE_DEBUGGERS
+		timing->globalCycles += timing->root->when - timing->masterCycles;
+#endif
+		timing->masterCycles = timing->root->when;
+		timing->root = timing->root->next;
+		_dmaEventOnce(timing, context, 0);
+	}
+}
+
 void GBADMAUpdate(struct GBA* gba) {
 	int i;
 	struct GBAMemory* memory = &gba->memory;
