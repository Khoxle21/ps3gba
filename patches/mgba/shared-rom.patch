+// ps3gba: GPIO registers read from the cartridge's state instead of being stored into the ROM, so
+// GPIO carts (RTC) keep sharing one read-only ROM and never copy it (32 MB per player). Write-only
+// GPIO reads the ROM, as on hardware.
+static inline uint16_t _gpioLoad16(const struct GBAMemory* memory, uint32_t offset, uint16_t rom) {
+	if (!(memory->hw.devices & HW_GPIO) || memory->hw.readWrite != GPIO_READ_WRITE) {
+		return rom;
+	}
+	switch (offset) {
+	case GPIO_REG_DATA:
+		return memory->hw.pinState;
+	case GPIO_REG_DIRECTION:
+		return memory->hw.direction;
+	case GPIO_REG_CONTROL:
+		return memory->hw.readWrite;
+	default:
+		return rom;
+	}
+}
