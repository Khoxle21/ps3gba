#---------------------------------------------------------------------------------
# ps3gba - PSL1GHT makefile (based on the PSL1GHT sample template).
# Run through ./build.sh, which builds libmgba first.
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(PSL1GHT)),)
$(error "Please set PSL1GHT in your environment. export PSL1GHT=<path>")
endif

include $(PSL1GHT)/ppu_rules

TARGET		:=	ps3gba
BUILD		:=	build
SOURCES		:=	source source/jit third_party/qrcodegen
DATA		:=	data
INCLUDES	:=	include source third_party/stb_vorbis third_party/qrcodegen

TITLE		:=	ps3gba
APPID		:=	PGBA00001
CONTENTID	:=	UP0001-$(APPID)_00-0000000000000000
# XMB icon, generated by tools/gen_art.py
ICON0		:=	$(CURDIR)/ICON0.PNG
# PARAM.SFO's template: PSL1GHT's, with stereo sound only
SFOXML		:=	$(CURDIR)/sfo.xml

MGBA		:=	$(CURDIR)/third_party/mgba
MGBA_BUILD	:=	$(CURDIR)/mgba-build

CFLAGS		=	-O2 -Wall -mcpu=cell $(MACHDEP) $(INCLUDE) $(MGBA_FLAGS)
# make DEV=1: dev-only tools (scripted input, see main.c)
ifeq ($(DEV),1)
CFLAGS		+=	-DDEV_TOOLS
endif
ifneq ($(LINK_CABLES),)
CFLAGS		+=	-DLINK_CABLES=$(LINK_CABLES)
endif
# make DEV=1 TIMES=1: the dev log's `time P<n>` split of the JIT's run loop (costs ~1% of a frame)
ifeq ($(TIMES),1)
CFLAGS		+=	-DJIT_TIMES
endif
# make JIT_CACHE_MB=n: size of the JIT code cache in .text (default 16, 4 player slices)
ifneq ($(JIT_CACHE_MB),)
CFLAGS		+=	-DJIT_CACHE_MB=$(JIT_CACHE_MB)
endif
CXXFLAGS	=	$(CFLAGS)
LDFLAGS		=	$(MACHDEP) -Wl,-Map,$(notdir $@).map

LIBS	:=	-lmgba -ltiny3d -lcairo -lpixman-1 -lfreetype -lpng -lz \
			-laudio -lrsx -lgcm_sys -lio -lsysutil -lnetctl -lnet -lsysmodule -lpthread -lrt -llv2 -lm

ifneq ($(BUILD),$(notdir $(CURDIR)))

export OUTPUT	:=	$(CURDIR)/$(TARGET)
export CHANGELOG	:=	$(CURDIR)/CHANGELOG.md
# mGBA's struct layouts depend on its build defines, so reuse exactly the ones libmgba was built with.
# -fwrapv too: mGBA's cycle math (e.g. the link cable's) relies on signed overflow wrapping.
export MGBA_FLAGS	:=	$(filter -D% -U% -fwrapv,$(shell sed -n 's/^C_\(DEFINES\|FLAGS\) = //p' $(MGBA_BUILD)/CMakeFiles/mgba.dir/flags.make))
export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) $(foreach dir,$(DATA),$(CURDIR)/$(dir))
export DEPSDIR	:=	$(CURDIR)/$(BUILD)
export BUILDDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.ttf $(dir)/*.ogg $(dir)/*.html)))
export LD	:=	$(CC)
export OFILES	:=	$(addsuffix .o,$(BINFILES)) render_spu.bin.o $(CFILES:.c=.o) gba_lockstep.o
export MGBA_LOCKSTEP	:=	$(MGBA)/src/gba/sio/lockstep.c
export MGBA_LIB	:=	$(MGBA_BUILD)/libmgba.a # the app relinks when it changes (patches/mgba/)
# The SPU renderer (spu/render.c + mGBA's software renderer), embedded as an ELF image.
# -Os: code, VRAM copy and renderer state must fit the SPU's 256 KB local store.
export SPU_SOURCES	:=	$(CURDIR)/spu/render.c $(foreach f,video-software software-bg software-mode0 software-obj common,$(MGBA)/src/gba/renderers/$(f).c)
export SPU_CFLAGS	:=	-Os -Wall -Wno-maybe-uninitialized -Wno-format -D__BIG_ENDIAN__ -DCOLOR_16_BIT -DCOLOR_5_6_5 -DM_CORE_GBA -DDISABLE_THREADING \
					-I$(CURDIR)/include -I$(MGBA)/include -I$(MGBA)/src -I$(MGBA_BUILD)/include \
					-I$(PSL1GHT)/spu/include -L$(PSL1GHT)/spu/lib \
					-ffunction-sections -fdata-sections -Wl,--gc-sections

export INCLUDE	:=	$(foreach dir,$(INCLUDES), -I$(CURDIR)/$(dir)) \
					-I$(MGBA)/include -I$(MGBA_BUILD)/include \
					-I$(PORTLIBS)/include -I$(PORTLIBS)/include/freetype2 \
					$(LIBPSL1GHT_INC) -I$(CURDIR)/$(BUILD)

export LIBPATHS	:=	-L$(MGBA_BUILD) -L$(PORTLIBS)/lib $(LIBPSL1GHT_LIB)

.PHONY: $(BUILD) clean run pkg

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile

clean:
	@echo clean ...
	@rm -fr $(BUILD) mgba-build $(OUTPUT).elf $(OUTPUT).self $(OUTPUT).fake.self

run:
	ps3load $(OUTPUT).self

pkg: $(BUILD) $(OUTPUT).pkg

else

DEPENDS	:=	$(OFILES:.o=.d)

# The JIT writes its code cache inside .text. Real hardware allows that; RPCS3 maps a segment
# without the ELF W flag read-only. So the .self (run by RPCS3) gets an RWX code segment and the
# pkg's EBOOT.BIN (real hardware) keeps the plain R-X one (see docs/ps3-homebrew-notes.md).
$(OUTPUT).self: $(OUTPUT).elf
	$(VERB) echo CEX self ... $(notdir $@)
	$(VERB) mkdir -p $(BUILDDIR)
	$(VERB) $(STRIP) $< -o $(BUILDDIR)/$(notdir $<)
	$(VERB) $(SPRX) $(BUILDDIR)/$(notdir $<)
	$(VERB) cp $(BUILDDIR)/$(notdir $<) $(BUILDDIR)/rpcs3.elf
	$(VERB) printf '\000\000\000\007' | dd of=$(BUILDDIR)/rpcs3.elf bs=1 seek=68 conv=notrunc 2>/dev/null
	$(VERB) $(SELF) $(BUILDDIR)/rpcs3.elf $@
	$(VERB) $(FSELF) $(BUILDDIR)/rpcs3.elf $(basename $@).fake.self
$(OUTPUT).elf:	$(OFILES) $(MGBA_LIB)

# Embedded files' headers are generated alongside their objects.
gfx.o: pressstart2p.ttf.o
audio.o: music.ogg.o
web.o: pressstart2p.ttf.o phone.html.o

# The phone page (data/phone.html), served by web.c.
%.html.o: %.html
	@echo $(notdir $<)
	@$(bin2o)
spu_render.o: render_spu.bin.o

%.ogg.o: %.ogg
	@echo $(notdir $<)
	@$(bin2o)

# mGBA's GBA link cable, left out of its minimal build (patched: patches/mgba/lockstep-clock.patch).
gba_lockstep.c: $(MGBA_LOCKSTEP)
	@echo $(notdir $@)
	@cp $< $@

render_spu.bin: $(SPU_SOURCES) $(CURDIR)/../include/spu_render.h
	@echo spu render
	@$(PS3DEV)/spu/bin/spu-gcc $(SPU_CFLAGS) $(SPU_SOURCES) -lsputhread -o render_spu.elf
	@$(PS3DEV)/spu/bin/spu-size render_spu.elf
	@$(PS3DEV)/spu/bin/spu-strip -o $@ render_spu.elf

# Objects rebuild when the compile flags change (DEV, TIMES, LINK_CABLES, JIT_CACHE_MB).
ifneq ($(strip $(CFLAGS)),$(strip $(file <cflags.txt)))
$(file >cflags.txt,$(strip $(CFLAGS)))
endif
$(filter-out %.bin.o %.ttf.o %.ogg.o %.html.o,$(OFILES)): cflags.txt

# The version on the welcome screen: CHANGELOG.md's newest entry ("## x.y.z - date").
APP_VERSION := $(shell sed -n 's/^## \([0-9][0-9.]*\) .*/\1/p' $(CHANGELOG) | head -n 1)
ifeq ($(APP_VERSION),)
$(error no version in $(CHANGELOG): its newest entry must start with "## x.y.z - date")
endif
intro.o: CFLAGS += -DAPP_VERSION='"$(APP_VERSION)"'
intro.o: $(CHANGELOG)

-include $(DEPENDS)

endif
